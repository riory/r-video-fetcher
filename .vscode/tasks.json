{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build r-video-fetcher",
      "type": "process",
      "command": "cargo",
      "args": ["build", "--bin", "r-video-fetcher"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Run r-video-fetcher",
      "type": "process",
      "command": "cargo",
      "args": ["run", "--bin", "r-video-fetcher"],
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "Test r-video-fetcher",
      "type": "process",
      "command": "cargo",
      "args": ["test"],
      "group": "test",
      "problemMatcher": ["$rustc"]
    }
  ]
}
